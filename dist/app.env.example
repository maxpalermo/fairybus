# Configurazione CodeIgniter 4 (generata da install.sh)
# Montata come /var/www/html/.env dentro il container app

CI_ENVIRONMENT = production
app.baseURL = http://localhost:8080/
app.indexPage =

database.default.hostname = db
database.default.database = fairybus_db
database.default.username = fairybus
database.default.password = changeme
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306

encryption.key = hex2bin:CHANGEME

# Subnet CIDR dei reverse proxy attendibili (X-Forwarded-For), separate da virgola.
# Copre di default le reti private usate da Docker/LAN; restringere se serve.
app.proxyIPs = 172.16.0.0/12,10.0.0.0/8,192.168.0.0/16
