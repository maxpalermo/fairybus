{% extends "admin/layout.twig" %}

{% block page_styles %}
    <link rel="stylesheet" href="{{ asset('fairy-bus/css/pages/calendar.css?v=14') }}">
{% endblock %}

{% block content %}
    <section class="fb-page">
        <div class="fb-page-header">
            <div>
                <h1 class="fb-page-title">Calendario scadenze</h1>
                <p class="fb-page-subtitle">Avvisi, calendario mensile e scadenze dei veicoli.</p>
            </div>
            <div class="fb-page-actions">
                <div class="fb-page-actions" data-field="list-actions">
                    <span class="fb-muted fb-selected-count" id="cal-selected-count">0 selezionate</span>
                    <button type="button" class="fb-btn-icon fb-btn-icon-warning" data-action="print" title="Stampa PDF (righe selezionate, max 500)">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 6 2 18 2 18 9"></polyline><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path><rect x="6" y="14" width="12" height="8"></rect></svg>
                    </button>
                    <button type="button" class="fb-btn-icon" data-action="legend" title="Legenda stati">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg>
                    </button>
                    <button type="button" class="fb-btn-icon fb-btn-icon-success" data-action="new-expiration" title="Nuova scadenza">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                    </button>
                </div>
            </div>
        </div>

        <div class="fb-tabs fb-form-tabs fb-page-tabs" role="tablist">
            <button type="button" class="fb-tab active" data-tab="avvisi" role="tab" aria-selected="true">
                Avvisi <span class="fb-picker-count" data-field="alerts-badge">0</span>
            </button>
            <button type="button" class="fb-tab" data-tab="date" role="tab" aria-selected="false">Scadenze periodiche</button>
            <button type="button" class="fb-tab" data-tab="km" role="tab" aria-selected="false">Scadenze chilometriche</button>
            <button type="button" class="fb-tab" data-tab="vehicle" role="tab" aria-selected="false">Scadenze per veicolo</button>
            <button type="button" class="fb-tab" data-tab="storico" role="tab" aria-selected="false">Storico scadenziario</button>
            <button type="button" class="fb-tab" data-tab="calendario" role="tab" aria-selected="false">Calendario</button>
        </div>

        <div class="fb-tab-panel active" data-panel="avvisi" role="tabpanel">
            <div class="fb-alerts-panel">
                <div class="fb-alerts-list fb-alerts-open" data-field="alerts-list">
                    <div class="fb-alert-item fb-muted">Caricamento…</div>
                </div>
            </div>
        </div>

        <div class="fb-tab-panel" data-panel="date" role="tabpanel">
            <div class="fb-vehicle-toolbar">
                <label class="fb-switch fb-switch-warning">
                    <input type="checkbox" data-field="show-hidden">
                    <span class="fb-switch-slider"></span>
                    <span class="fb-switch-text">Vedi scadenze nascoste</span>
                </label>
            </div>
            <div class="fb-table-wrap">
                <table id="date-table" class="fb-table"></table>
            </div>
        </div>

        <div class="fb-tab-panel" data-panel="km" role="tabpanel">
            <div class="fb-vehicle-toolbar">
                <label class="fb-switch fb-switch-warning">
                    <input type="checkbox" data-field="show-hidden">
                    <span class="fb-switch-slider"></span>
                    <span class="fb-switch-text">Vedi scadenze nascoste</span>
                </label>
            </div>
            <div class="fb-table-wrap">
                <table id="km-table" class="fb-table"></table>
            </div>
        </div>

        <div class="fb-tab-panel" data-panel="vehicle" role="tabpanel">
            <div class="fb-vehicle-toolbar">
                <label class="fb-switch fb-switch-warning">
                    <input type="checkbox" data-field="show-hidden">
                    <span class="fb-switch-slider"></span>
                    <span class="fb-switch-text">Vedi scadenze nascoste</span>
                </label>
            </div>
            <div class="fb-table-wrap">
                <table id="vehicle-table" class="fb-table"></table>
            </div>
        </div>

        <div class="fb-tab-panel" data-panel="storico" role="tabpanel">
            <div class="fb-table-wrap">
                <table id="storico-table" class="fb-table"></table>
            </div>
        </div>

        <div class="fb-tab-panel" data-panel="calendario" role="tabpanel">
            <div class="fb-calendar-card">
                <div class="fb-calendar-head">
                    <h2 class="fb-calendar-month" data-field="month-title">—</h2>
                    <div class="fb-page-actions" data-field="cal-actions">
                        <button type="button" class="fb-btn-icon" data-action="cal-prev" title="Mese precedente">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
                        </button>
                        <button type="button" class="fb-btn fb-btn-secondary fb-btn-sm" data-action="cal-today">Oggi</button>
                        <button type="button" class="fb-btn-icon" data-action="cal-next" title="Mese successivo">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
                        </button>
                    </div>
                </div>
                <div class="fb-calendar-grid" data-field="grid"></div>
            </div>
        </div>
    </section>

    <template id="tpl-expiration-new">
        <form class="fb-form fb-expiration-form" data-form="expiration-new">
            <div class="fb-form-group">
                <label class="fb-form-label" for="occ_vehicle">Veicolo</label>
                <select id="occ_vehicle" name="id_vehicle" class="fb-form-input" data-field="vehicle" required></select>
                <span class="fb-km-badge" data-field="km-badge" hidden>
                    <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 15l3.5-3.5"/><path d="M4.5 19a10 10 0 1 1 15 0"/><circle cx="12" cy="15" r="1.5"/></svg>
                    Km attuali: <strong data-field="km-badge-value">—</strong>
                </span>
            </div>
            <div class="fb-form-grid">
                <div class="fb-form-group">
                    <label class="fb-form-label" for="occ_tag">Voce di scadenza</label>
                    <select id="occ_tag" name="id_expiration_tag" class="fb-form-input" data-field="tag"></select>
                </div>
                <div class="fb-form-group">
                    <label class="fb-form-label" for="occ_kind">Tipo</label>
                    <select id="occ_kind" name="kind" class="fb-form-input" data-field="kind">
                        <option value="date">Data</option>
                        <option value="km">Km</option>
                    </select>
                </div>
            </div>
            <div class="fb-exp-summary" data-field="exp-summary" hidden>
                <div class="fb-exp-summary-head">
                    <strong data-field="exp-name"></strong>
                    <span class="fb-exp-chip" data-field="exp-chip"></span>
                </div>
                <div class="fb-exp-flow" data-field="exp-flow">
                    <span>Ultima: <strong data-field="exp-last">—</strong></span>
                    <svg class="fb-exp-arrow" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                    <span>Prossima: <strong class="fb-exp-next" data-field="exp-next">—</strong></span>
                </div>
                <div class="fb-exp-hint" data-field="exp-hint" hidden>Seleziona il veicolo per calcolare la prossima scadenza</div>
            </div>
            <div class="fb-form-group" data-field="date-wrap">
                <label class="fb-form-label" for="occ_date">Scadenza (data)</label>
                <input type="date" id="occ_date" name="expiration_date" class="fb-form-input">
            </div>
            <div class="fb-form-group" data-field="km-wrap" hidden>
                <label class="fb-form-label" for="occ_km">Scadenza (km)</label>
                <input type="number" id="occ_km" name="expires_atkm" class="fb-form-input" min="0" step="1">
            </div>
            <div class="fb-form-group">
                <label class="fb-form-label" for="occ_desc">Descrizione</label>
                <input type="text" id="occ_desc" name="description" class="fb-form-input" maxlength="255">
            </div>
            <div class="fb-form-actions">
                <button type="submit" class="fb-btn fb-btn-primary">Salva</button>
                <button type="button" class="fb-btn fb-btn-secondary" data-action="close">Annulla</button>
            </div>
        </form>
    </template>
{% endblock %}

{% block page_scripts %}

    <script type="module" src="{{ asset('fairy-bus/js/pages/calendar.js?v=24') }}"></script>
{% endblock %}
