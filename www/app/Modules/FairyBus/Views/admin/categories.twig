{% extends "admin/layout.twig" %}

{% block page_styles %}
    <link rel="stylesheet" href="{{ asset('fairy-bus/css/pages/categories.css') }}?v=3">
{% endblock %}

{% block content %}
    <section class="fb-page">
        <div class="fb-page-header">
            <div>
                <h1 class="fb-page-title">Categorie</h1>
                <p class="fb-page-subtitle">Gestisci l'albero gerarchico delle categorie prodotti.</p>
            </div>
            <div class="fb-page-actions">
                <span class="fb-muted fb-selected-count" id="categories-selected-count">0 selezionati</span>
                <button type="button" class="fb-btn fb-btn-secondary" data-action="print-categories">Stampa PDF</button>
                <button type="button" class="fb-btn fb-btn-primary" data-action="new-category">Nuova categoria</button>
            </div>
        </div>

        <div class="fb-table-wrap">
            <table id="categories-table" class="fb-table"></table>
        </div>
    </section>

    <template id="tpl-category-form">
        <form class="fb-form" data-form="category">
            <input type="hidden" name="id_category" value="">
            <div class="fb-form-group">
                <label class="fb-form-label" for="category_name">Nome</label>
                <input type="text" id="category_name" name="name" class="fb-form-input" required maxlength="255">
            </div>
            <div class="fb-form-group">
                <label class="fb-form-label" for="category_parent">Categoria padre</label>
                <select id="category_parent" name="id_parent" class="fb-form-input"></select>
            </div>
            <div class="fb-form-group">
                <label class="fb-form-label" for="category_description">Descrizione</label>
                <textarea id="category_description" name="description" class="fb-form-input" rows="3"></textarea>
            </div>
            <div class="fb-form-group fb-form-check">
                <label class="fb-switch-label">
                    <input type="checkbox" name="active" value="1" checked>
                    <span class="fb-switch-slider"></span>
                    <span class="fb-feature-label">Attiva</span>
                </label>
            </div>
            <div class="fb-form-actions">
                <button type="submit" class="fb-btn fb-btn-primary">Salva</button>
                <button type="button" class="fb-btn fb-btn-secondary" data-action="close">Annulla</button>
            </div>
        </form>
    </template>
{% endblock %}

{% block page_scripts %}
    <script type="module" src="{{ asset('fairy-bus/js/pages/categories.js') }}?v=2"></script>
{% endblock %}
