{% extends "admin/layout.twig" %}

{% block page_styles %}
    <link rel="stylesheet" href="{{ asset('fairy-bus/css/pages/categories.css') }}?v=4">
{% endblock %}

{% block content %}
    <section class="fb-page">
        <div class="fb-page-header">
            <div>
                <h1 class="fb-page-title">Categorie</h1>
                <p class="fb-page-subtitle">Gestisci l'albero gerarchico delle categorie prodotti.</p>
            </div>
            <div class="fb-page-actions">
                <span class="fb-muted fb-selected-count" id="categories-selected-count">0 selezionati</span>
                <button type="button" class="fb-btn-icon fb-btn-icon-info" data-action="run-filters" title="Cerca: applica i filtri delle colonne">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                </button>
                <button type="button" class="fb-btn-icon fb-btn-icon-warning" data-action="print-categories" title="Stampa PDF (righe selezionate, max 500)">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 6 2 18 2 18 9"></polyline><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path><rect x="6" y="14" width="12" height="8"></rect></svg>
                </button>
                <button type="button" class="fb-btn-icon fb-btn-icon-success" data-action="new-category" title="Nuova categoria">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                </button>
            </div>
        </div>

        <div class="fb-table-wrap">
            <table id="categories-table" class="fb-table"></table>
        </div>
    </section>

    <template id="tpl-category-form">
        <form class="fb-form" data-form="category">
            <input type="hidden" name="id_category" value="">
            <div class="fb-form-group">
                <label class="fb-form-label" for="category_name">Nome</label>
                <input type="text" id="category_name" name="name" class="fb-form-input" required maxlength="255">
            </div>
            <div class="fb-form-group">
                <label class="fb-form-label" for="category_parent">Categoria padre</label>
                <select id="category_parent" name="id_parent" class="fb-form-input"></select>
            </div>
            <div class="fb-form-group">
                <label class="fb-form-label" for="category_description">Descrizione</label>
                <textarea id="category_description" name="description" class="fb-form-input" rows="3"></textarea>
            </div>
            <div class="fb-form-group fb-form-check">
                <label class="fb-switch fb-switch-success">
                    <input type="checkbox" name="active" value="1" checked>
                    <span class="fb-switch-slider"></span>
                    <span class="fb-switch-text">Attiva</span>
                </label>
            </div>
            <div class="fb-form-actions">
                <button type="submit" class="fb-btn fb-btn-primary">Salva</button>
                <button type="button" class="fb-btn fb-btn-secondary" data-action="close">Annulla</button>
            </div>
        </form>
    </template>
{% endblock %}

{% block page_scripts %}
    <script type="module" src="{{ asset('fairy-bus/js/pages/categories.js') }}?v=3"></script>
{% endblock %}
