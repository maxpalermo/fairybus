{% extends "admin/layout.twig" %}

{% block page_styles %}
    <link rel="stylesheet" href="{{ asset('fairy-bus/css/pages/customers.css') }}">
{% endblock %}

{% block content %}
    <section class="fb-page">
        <div class="fb-page-header">
            <div>
                <h1 class="fb-page-title">Clienti</h1>
                <p class="fb-page-subtitle">Elenco clienti importati e gestiti.</p>
            </div>
            <div class="fb-page-actions">
                <span class="fb-muted fb-selected-count" id="customers-selected-count">0 selezionati</span>
                <button type="button" class="fb-btn fb-btn-secondary" data-action="print-customers">Stampa PDF</button>
            </div>
        </div>

        <div class="fb-table-wrap">
            <table id="customers-table" class="fb-table"></table>
        </div>
    </section>
{% endblock %}

{% block page_scripts %}
    <script type="module" src="{{ asset('fairy-bus/js/pages/customers.js') }}"></script>
{% endblock %}
