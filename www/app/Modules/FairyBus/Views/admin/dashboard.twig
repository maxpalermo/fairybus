{% extends "admin/layout.twig" %}

{% block page_styles %}
    <link rel="stylesheet" href="{{ asset('fairy-bus/css/pages/dashboard.css') }}">
{% endblock %}

{% block content %}
    <section class="fb-dashboard">
        <header class="fb-dashboard-header">
            <h1>Dashboard</h1>
            <p class="fb-dashboard-subtitle">Panoramica dell'autorimessa: autobus, manutenzioni, scadenze e magazzino.</p>
        </header>

        <div class="fb-kpi-grid">
            {% for kpi in kpis %}
                <article class="fb-kpi-card">
                    <div class="fb-kpi-top">
                        <div>
                            <p class="fb-kpi-title">{{ kpi.title }}</p>
                            <p class="fb-kpi-value">{{ kpi.value }}</p>
                            <p class="fb-kpi-trend">{{ kpi.sub }}</p>
                        </div>
                        <div class="fb-kpi-icon" aria-hidden="true">
                            {% if kpi.icon == 'bus' %}
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="6" width="18" height="10" rx="2"></rect><path d="M6 18v2"></path><path d="M18 18v2"></path><path d="M6 10h12"></path><path d="M7 3h10"></path></svg>
                            {% elseif kpi.icon == 'wrench' %}
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path></svg>
                            {% elseif kpi.icon == 'calendar' %}
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"></rect><path d="M16 2v4"></path><path d="M8 2v4"></path><path d="M3 10h18"></path></svg>
                            {% elseif kpi.icon == 'fuel' %}
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 22h12"></path><path d="M4 9h10"></path><path d="M14 22V4a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v18"></path><path d="M14 13h2a2 2 0 0 1 2 2v2a2 2 0 0 0 2 2 2 2 0 0 0 2-2V9.83a2 2 0 0 0-.59-1.42L18 5"></path></svg>
                            {% else %}
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 11l3 3L22 4"></path><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path></svg>
                            {% endif %}
                        </div>
                    </div>
                    <svg class="fb-sparkline" viewBox="0 0 120 40" preserveAspectRatio="none">
                        <path d="{{ kpi.sparkline }}" fill="none" stroke="{{ kpi.color|default('#0ea5e9') }}" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
                    </svg>
                </article>
            {% endfor %}
        </div>

        <div class="fb-dashboard-row">
            <section class="fb-card fb-overview-card">
                <div class="fb-card-header">
                    <div>
                        <h2 class="fb-card-title">Andamento</h2>
                        <p class="fb-card-subtitle">Ultimi 12 anni</p>
                    </div>
                    <div class="fb-overview-tabs" role="tablist">
                        {% for name, path in overview_paths %}
                            <button type="button" class="fb-overview-tab{% if loop.first %} active{% endif %}" data-series="{{ name }}" role="tab" aria-selected="{{ loop.first ? 'true' : 'false' }}">{{ name }}</button>
                        {% endfor %}
                    </div>
                </div>
                <div class="fb-chart-wrap">
                    <svg class="fb-line-chart" viewBox="0 0 760 220" preserveAspectRatio="none">
                        {% for name, path in overview_paths %}
                            <g class="fb-chart-series" data-series="{{ name }}" {% if not loop.first %}style="display: none;"{% endif %}>
                                <path d="{{ path.area }}" fill="{{ path.color }}" fill-opacity="0.1" stroke="none"></path>
                                <path d="{{ path.line }}" fill="none" stroke="{{ path.color }}" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"></path>
                            </g>
                        {% endfor %}
                    </svg>
                    <div class="fb-chart-labels">
                        {% for label in overview_labels %}
                            <span>{{ label }}</span>
                        {% endfor %}
                    </div>
                </div>
            </section>

            <section class="fb-card fb-expirations-card">
                <div class="fb-card-header">
                    <div>
                        <h2 class="fb-card-title">Scadenze</h2>
                        <p class="fb-card-subtitle">Imminenti e scadute non eseguite</p>
                    </div>
                </div>
                <ul class="fb-expiration-list">
                    {% for item in upcoming_expirations %}
                        <li>
                            <div class="fb-expiration-main">
                                <span class="fb-expiration-title">{{ item.label }}</span>
                                <span class="fb-expiration-vehicle">{{ item.vehicle }}</span>
                            </div>
                            <div class="fb-expiration-meta">
                                <span class="fb-expiration-type">{{ item.type }}</span>
                                <span class="fb-expiration-date{% if item.expired %} fb-expiration-expired{% endif %}">{{ item.due_label }}</span>
                            </div>
                        </li>
                    {% endfor %}
                </ul>
            </section>
        </div>

        <div class="fb-dashboard-row">
            <section class="fb-card fb-traffic-card">
                <div class="fb-card-header">
                    <div>
                        <h2 class="fb-card-title">Distribuzione scadenze</h2>
                        <p class="fb-card-subtitle">Per tipologia</p>
                    </div>
                </div>
                <div class="fb-donut-wrap">
                    <svg class="fb-donut" viewBox="0 0 120 120">
                        {% set circumference = 314.16 %}
                        {% set offset = 0 %}
                        {% for source in expiration_distribution %}
                            {% set dash = source.value * circumference / 100 %}
                            {% set gap = circumference - dash %}
                            <circle cx="60" cy="60" r="50" fill="none" stroke="{{ source.color }}" stroke-width="12" stroke-dasharray="{{ dash|round(2) }} {{ gap|round(2) }}" stroke-dashoffset="-{{ offset|round(2) }}" transform="rotate(-90 60 60)"></circle>
                            {% set offset = offset + dash %}
                        {% endfor %}
                    </svg>
                    <div class="fb-donut-center">
                        <span>{{ expiration_total }}</span>
                        <small>scadenze aperte</small>
                    </div>
                </div>
                <ul class="fb-legend">
                    {% for source in expiration_distribution %}
                        <li>
                            <span class="fb-legend-dot" style="background-color: {{ source.color }};"></span>
                            <span class="fb-legend-label">{{ source.label }}</span>
                            <span class="fb-legend-value">{{ source.value }}%</span>
                        </li>
                    {% endfor %}
                </ul>
            </section>

            <section class="fb-card fb-stock-card">
                <div class="fb-card-header">
                    <div>
                        <h2 class="fb-card-title">Ricambi sotto scorta</h2>
                        <p class="fb-card-subtitle">Quantità inferiori alla soglia minima</p>
                    </div>
                </div>
                <div class="fb-stock-list">
                    {% for part in low_stock_parts %}
                        {% set pct = part.threshold > 0 ? (part.qty / part.threshold * 100)|round(1) : 0 %}
                        <div class="fb-stock-item">
                            <div class="fb-stock-header">
                                <span class="fb-stock-name">{{ part.name }}</span>
                                <span class="fb-stock-qty">{{ part.qty }} / {{ part.threshold }}</span>
                            </div>
                            <div class="fb-progress">
                                <div class="fb-progress-bar fb-progress-bar-danger" style="width: {{ pct }}%;"></div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </section>
        </div>
    </section>
{% endblock %}

{% block page_scripts %}
    <script type="module" src="{{ asset('fairy-bus/js/pages/dashboard.js') }}"></script>
{% endblock %}
