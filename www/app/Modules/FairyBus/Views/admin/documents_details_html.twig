<!DOCTYPE html>
<html lang="it">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title|default('Report documenti') }}</title>
<style>
    * { box-sizing: border-box; }
    body { font-family: 'DejaVu Sans', Arial, sans-serif; font-size: 11px; color: #18181b; margin: 0; padding: 1.5rem; }
    h1 { font-size: 1.25rem; margin: 0 0 0.25rem; }
    h3 { margin: 1.5rem 0 0.375rem; font-size: 0.95rem; }
    .meta { color: #71717a; font-size: 0.8125rem; margin-bottom: 1rem; }
    .muted { color: #71717a; }
    .center { text-align: center; }
    table { width: 100%; border-collapse: collapse; margin-bottom: 0.5rem; }
    th, td { border: 1px solid #e4e4e7; padding: 4px 6px; text-align: left; vertical-align: top; }
    th { background: #f4f4f5; font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.03em; }
    .num { text-align: right; white-space: nowrap; }
    .tot-row td { font-weight: 700; border-top: 2px solid #18181b; }
    .doc { page-break-inside: auto; margin-bottom: 1.5rem; }
    .doc-break { page-break-before: always; }
    .toolbar { position: sticky; top: 0; display: flex; gap: 0.5rem; align-items: center; background: #fff; padding: 0.5rem 0; border-bottom: 1px solid #e4e4e7; margin-bottom: 1rem; z-index: 10; }
    .toolbar button { height: 2.25rem; padding: 0 0.875rem; border: 1px solid #18181b; border-radius: 0.375rem; background: #18181b; color: #fff; font-size: 0.8125rem; font-weight: 600; cursor: pointer; }
    .toolbar button.secondary { background: #fff; color: #18181b; }
    @media print {
        .toolbar { display: none; }
        body { padding: 0; }
        tr { page-break-inside: avoid; }
        thead { display: table-header-group; }
    }
</style>
</head>
<body>
    <div class="toolbar">
        <button type="button" onclick="window.print()">Stampa / Salva PDF</button>
        <button type="button" class="secondary" onclick="window.close()">Chiudi</button>
        <span class="meta">{{ documents|length }} documenti{% if period_label %} — periodo {{ period_label }}{% endif %}</span>
    </div>

    <h1>{{ title|default('Report documenti') }}</h1>
    <div class="meta">Generato il {{ "now"|date('d/m/Y H:i') }}{% if user and user.name %} — {{ user.name }}{% endif %}</div>

    {% for document in documents %}
        <div class="doc{% if not loop.first %} doc-break{% endif %}">
            <h3>
                Documento {{ document.number|default('#' ~ document.id_document) }} — {{ document.supplier_name|default(document.customer_name)|default('—') }}
            </h3>
            <table>
                <tbody>
                    <tr>
                        <td style="width: 18%;" class="muted">{{ document.id_customer ? 'Cliente' : 'Fornitore' }}</td>
                        <td><strong>{{ document.supplier_name|default(document.customer_name)|default('—') }}</strong></td>
                        <td style="width: 12%;" class="muted">Numero</td>
                        <td>{{ document.number|default('—') }}</td>
                    </tr>
                    <tr>
                        <td class="muted">Data</td>
                        <td>{{ document.date ? document.date|date('d/m/Y') : '—' }}</td>
                        {% if document.id_customer %}
                            <td class="muted">Targa</td>
                            <td>{{ document.vehicle_plate|default('—') }}</td>
                        {% else %}
                            <td class="muted">Fattura</td>
                            <td>{{ document.invoice_number|default('—') }}</td>
                        {% endif %}
                    </tr>
                    <tr>
                        <td class="muted">Tipo</td>
                        <td colspan="3">{{ document.type_name|default('—') }}</td>
                    </tr>
                    {% if document.note %}
                        <tr>
                            <td class="muted">Nota</td>
                            <td colspan="3">{{ document.note }}</td>
                        </tr>
                    {% endif %}
                </tbody>
            </table>

            {% set is_out = document.id_customer is not empty %}
            {% set colw = is_out ? {qty: 6, code: 12, price: 10, disc: 7, amount: 10, vat: 8, tot: 10} : {qty: 8, code: 15, price: 11, disc: 9, amount: 12, vat: 10, tot: 12} %}
            <table>
                <thead>
                    <tr>
                        {% if is_out %}<th style="width: 19%;">Scheda</th>{% endif %}
                        <th style="width: {{ colw.qty }}%;" class="num">Q.tà</th>
                        <th style="width: {{ colw.code }}%;">Codice</th>
                        <th>Articolo</th>
                        <th style="width: {{ colw.price }}%;" class="num">Prezzo</th>
                        <th style="width: {{ colw.disc }}%;" class="num">Sconto</th>
                        <th style="width: {{ colw.amount }}%;" class="num">Importo</th>
                        <th style="width: {{ colw.vat }}%;">I.v.a.</th>
                        <th style="width: {{ colw.tot }}%;" class="num">Totale</th>
                    </tr>
                </thead>
                <tbody>
                    {% set total = 0 %}
                    {% set totalQty = 0 %}
                    {% for row in document.details %}
                        {% set qty = row.quantity|abs %}
                        {% set importo = qty * row.price * (1 - (row.discount|default(0)|abs) / 100) %}
                        {% set vat = row.vat_rate is not null ? row.vat_rate : 0 %}
                        {% set rowTotal = importo * (1 + vat / 100) %}
                        {% set total = total + rowTotal %}
                        {% set totalQty = totalQty + qty %}
                        <tr>
                            {% if is_out %}<td>{{ row.id_maintenance ? 'Scheda ' ~ row.id_maintenance ~ (row.maintenance_date ? ' del ' ~ row.maintenance_date|date('d/m/Y') : '') : '—' }}</td>{% endif %}
                            <td class="num">{{ qty|number_format(3, ',', '.')|trim('0', 'right')|trim(',', 'right') ?: '0' }}</td>
                            <td>{{ row.sku|default('—') }}</td>
                            <td>{{ row.product_name|default('—') }}</td>
                            <td class="num">{{ row.price|eur }}</td>
                            <td class="num">{{ row.discount|default(0)|abs|number_format(0) }}%</td>
                            <td class="num">{{ importo|eur }}</td>
                            <td>{% if row.vat_rate is not null or row.vat_code is not null %}{{ (row.vat_rate ?? row.vat_code)|number_format(2, ',', '.') }}%{% else %}—{% endif %}</td>
                            <td class="num">{{ rowTotal|eur }}</td>
                        </tr>
                    {% else %}
                        <tr><td colspan="{{ is_out ? 9 : 8 }}" class="center muted">Nessun movimento.</td></tr>
                    {% endfor %}
                </tbody>
                {% if document.details|length > 0 %}
                    <tfoot>
                        <tr class="tot-row">
                            {% if is_out %}<td></td>{% endif %}
                            <td class="num"><strong>{{ totalQty|number_format(3, ',', '.')|trim('0', 'right')|trim(',', 'right') ?: '0' }}</strong></td>
                            <td colspan="4"></td>
                            <td class="muted">Totale documento</td>
                            <td></td>
                            <td class="num"><strong>{{ total|eur }}</strong></td>
                        </tr>
                    </tfoot>
                {% endif %}
            </table>
        </div>
    {% endfor %}

    {% if documents|length > 1 %}
        <div class="doc-break">
            <h3>Riepilogo articoli</h3>
            <table>
                <thead>
                    <tr>
                        <th style="width: 15%;">Codice</th>
                        <th>Articolo</th>
                        <th style="width: 10%;" class="num">Q.tà</th>
                        <th style="width: 13%;" class="num">Prezzo medio</th>
                        <th style="width: 14%;" class="num">Imponibile</th>
                        <th style="width: 14%;" class="num">Totale ivato</th>
                    </tr>
                </thead>
                <tbody>
                    {% for row in summary %}
                        <tr>
                            <td>{{ row.sku }}</td>
                            <td>{{ row.product_name }}</td>
                            <td class="num">{{ row.qty|abs|number_format(3, ',', '.')|trim('0', 'right')|trim(',', 'right') ?: '0' }}</td>
                            <td class="num">{{ (row.qty > 0 ? row.amount / row.qty : 0)|eur }}</td>
                            <td class="num">{{ row.amount|eur }}</td>
                            <td class="num">{{ row.total|eur }}</td>
                        </tr>
                    {% else %}
                        <tr><td colspan="6" class="center muted">Nessun articolo.</td></tr>
                    {% endfor %}
                </tbody>
                {% if summary|length > 0 %}
                    <tfoot>
                        <tr>
                            <td colspan="4" style="border-top: 2px solid #18181b;"></td>
                            <td class="muted" style="border-top: 2px solid #18181b;">Totale generale</td>
                            <td class="num" style="border-top: 2px solid #18181b;"><strong>{{ grand_total|eur }}</strong></td>
                        </tr>
                    </tfoot>
                {% endif %}
            </table>
        </div>
    {% endif %}
</body>
</html>
