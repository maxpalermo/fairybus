<!DOCTYPE html>
<html lang="it">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <meta name="csrf-token-name" content="{{ csrf.name }}">
        <meta name="csrf-token" content="{{ csrf.value }}">
        <title>{{ page_title }} — {{ app_name }}</title>
        <link rel="icon" type="image/png" href="{{ asset('fairy-bus/img/favicon.png') }}">
        <link rel="stylesheet" href="{{ asset('fairy-bus/css/theme.css') }}">
        <link rel="stylesheet" href="{{ asset('fairy-bus/css/layout.css') }}?v=2">
        <link rel="stylesheet" href="{{ asset('fairy-bus/css/components/dialog.css') }}">
        <link rel="stylesheet" href="{{ asset('fairy-bus/css/components/toast.css') }}">
        <link rel="stylesheet" href="{{ asset('fairy-bus/css/components/chosen-override.css') }}">
        <link rel="stylesheet" href="{{ asset('fairy-bus/css/components/table-select.css') }}">
        {% block page_styles %}{% endblock %}
    </head>
    <body>
        <div class="fb-app">
            <aside class="fb-sidebar" id="sidebar">
                <div class="fb-brand">
                    <img src="{{ asset('fairy-bus/img/favicon.png') }}" alt="" class="fb-brand-logo">
                    <span class="fb-brand-name">{{ app_name }}</span>
                </div>
                <nav aria-label="Menu principale">
                    {% set icons = {
                    'dashboard': '<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1"></rect><rect x="14" y="3" width="7" height="7" rx="1"></rect><rect x="14" y="14" width="7" height="7" rx="1"></rect><rect x="3" y="14" width="7" height="7" rx="1"></rect></svg>',
                    'book': '<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H19a1 1 0 0 1 1 1v18a1 1 0 0 1-1 1H6.5a1 1 0 0 1 0-5H20"></path></svg>',
                    'wrench': '<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path></svg>',
                    'box': '<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m7.5 4.27 9 5.15"></path><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"></path><path d="m3.3 7 8.7 5 8.7-5"></path><path d="M12 22V12"></path></svg>',
                    'file': '<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line></svg>',
                    'settings': '<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.1a2 2 0 0 1-1-1.72v-.51a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"></path><circle cx="12" cy="12" r="3"></circle></svg>',
                    'users': '<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M22 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>',
                    'truck': '<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 17h4V5H2v12h3"></path><path d="M20 17h2v-3.34a4 4 0 0 0-1.17-2.83L19 9h-5"></path><path d="M14 17h1"></path><circle cx="7.5" cy="17.5" r="2.5"></circle><circle cx="17.5" cy="17.5" r="2.5"></circle></svg>',
                    'tag': '<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12.586 2.586A2 2 0 0 0 11.172 2H4a2 2 0 0 0-2 2v7.172a2 2 0 0 0 .586 1.414l8.704 8.704a2.426 2.426 0 0 0 3.42 0l6.58-6.58a2.426 2.426 0 0 0 0-3.42z"></path><circle cx="7.5" cy="7.5" r=".5" fill="currentColor"></circle></svg>',
                    'sliders': '<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 13h2.5l5-5"></path><path d="M21 13h-5"></path><path d="M3 6h11"></path><path d="M21 6h-2.5l-5 5"></path><path d="M3 20h8"></path><path d="M21 20h-8"></path></svg>',
                    'fuel': '<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="22" x2="15" y2="22"></line><line x1="4" y1="9" x2="14" y2="9"></line><path d="M14 22V4a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v18"></path><path d="M14 13h2a2 2 0 0 1 2 2v2a2 2 0 0 0 2 2 2 2 0 0 0 2-2V9.83a2 2 0 0 0-.59-1.42L18 5"></path></svg>',
                    'chevron': '<svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>'
                } %}
                    <ul class="fb-nav">
                        {% for item in menu %}
                            {% set sectionClass = 'fb-nav-section-' ~ (item.icon|default('default')) %}
                            <li class="{{ item.children is defined and item.children|length > 0 ? 'fb-nav-parent' : '' }} {{ sectionClass }}">
                                {% set itemStyle = item.color_bg ? ' style="background:' ~ item.color_bg ~ ';color:' ~ (item.color_fg|default('inherit')) ~ '"' : '' %}
                                {% if item.children is defined and item.children|length > 0 %}
                                    <button type="button" class="fb-nav-toggle" aria-expanded="{{ item.active ? 'true' : 'false' }}"{{ itemStyle|raw }}>
                                        <span class="fb-nav-toggle-label">
                                            <span class="fb-nav-icon">{{ icons[item.icon|default('dashboard')]|raw }}</span>
                                            <span>{{ item.label }}</span>
                                        </span>
                                        <span class="fb-nav-chevron">{{ icons['chevron']|raw }}</span>
                                    </button>
                                    <ul class="fb-nav-submenu">
                                        {% for child in item.children %}
                                            {% set childStyle = child.color_bg ? ' style="background:' ~ child.color_bg ~ ';color:' ~ (child.color_fg|default('inherit')) ~ '"' : '' %}
                                            <li>
                                                <a href="{{ child.url }}" {% if child.active %}aria-current="page"{% endif %}{{ childStyle|raw }}>
                                                    <span class="fb-nav-bullet"></span>
                                                    {{ child.label }}
                                                </a>
                                            </li>
                                        {% endfor %}
                                    </ul>
                                {% else %}
                                    <a href="{{ item.url }}" {% if item.active %}aria-current="page"{% endif %} class="{{ sectionClass }}"{{ itemStyle|raw }}>
                                        <span class="fb-nav-icon">{{ icons[item.icon|default('dashboard')]|raw }}</span>
                                        <span>{{ item.label }}</span>
                                    </a>
                                {% endif %}
                            </li>
                        {% endfor %}
                    </ul>
                </nav>
            </aside>

            <header class="fb-header">
                <div class="fb-header-left">
                    {{ page_title }}
                </div>
                <div class="fb-header-right">
                    <span class="fb-user-chip">
                        <span>{{ user.name }}</span>
                        <span>·</span>
                        <span>{{ user.role }}</span>
                    </span>
                    <form method="post" action="{{ base_url('logout') }}" class="fb-logout-form">
                        <input type="hidden" name="{{ csrf.name }}" value="{{ csrf.value }}">
                        <button type="submit" class="fb-btn fb-btn-ghost">Esci</button>
                    </form>
                </div>
            </header>

            <main class="fb-content" id="main-content">
                {% block content %}{% endblock %}
            </main>
        </div>

        <template id="tpl-fb-dialog">
            <dialog class="fb-dialog" data-fb-dialog>
                <div class="fb-dialog-header">
                    <h3 class="fb-dialog-title" data-slot="title"></h3>
                    <button type="button" class="fb-dialog-close" data-slot="close" aria-label="Chiudi">
                        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M18 6 6 18M6 6l12 12"></path>
                        </svg>
                    </button>
                </div>
                <div class="fb-dialog-body" data-slot="body"></div>
                <div class="fb-dialog-footer" data-slot="footer"></div>
            </dialog>
        </template>

        <script>
        window.FB = {
            baseUrl: {{ base_url()|json_encode|raw }},
            csrf: {
                name: {{ csrf.name|json_encode|raw }},
                value: {{ csrf.value|json_encode|raw }}
            },
            toast: {{ toast_prefs|json_encode|raw }}
        };
    </script>

        <script src="{{ asset('fairy-bus/vendors/jquery/jquery.min.js') }}" defer></script>
        <script src="{{ asset('fairy-bus/vendors/chosen/chosen.jquery.min.js') }}" defer></script>
        <link rel="stylesheet" href="{{ asset('fairy-bus/vendors/chosen/chosen.min.css') }}">
        <script src="{{ asset('fairy-bus/vendors/bootstrap-table/bootstrap-table.min.js') }}" defer></script>
        <script src="{{ asset('fairy-bus/vendors/bootstrap-table/bootstrap-table-filter-control.min.js') }}" defer></script>
        <script src="{{ asset('fairy-bus/js/core/filter-patterns.js') }}" defer></script>
        <script src="{{ asset('fairy-bus/js/components/table-filter-select.js') }}" defer></script>
        <script type="module" src="{{ asset('fairy-bus/js/core/toggle-field.js') }}"></script>
        <link rel="stylesheet" href="{{ asset('fairy-bus/vendors/bootstrap-table/bootstrap-table.min.css') }}">
        <link rel="stylesheet" href="{{ asset('fairy-bus/css/components/table.css') }}?v=10">
        <script>
            document.addEventListener("DOMContentLoaded", function () {
                document.querySelectorAll(".fb-nav-toggle").forEach(function (toggle) {
                    toggle.addEventListener("click", function () {
                        const expanded = toggle.getAttribute("aria-expanded") === "true";
                        toggle.setAttribute("aria-expanded", expanded ? "false" : "true");
                    });
                });

                // Select dei filtri per colonna ricercabili (dropdown su body, niente clipping)
                if (window.jQuery && window.fbInitTableFilterSelects) {
                    jQuery(document).on("created-controls.bs.table", "table", function () {
                        window.fbInitTableFilterSelects(this);
                    });
                }
            });
        </script>

        {% block page_scripts %}{% endblock %}

        <script>
            // Bootstrap Table page-size dropdown fallback (Bootstrap JS not loaded)
            document.addEventListener("DOMContentLoaded", function () {
                document.addEventListener("click", function (e) {
                    const toggle = e.target.closest(
                        ".fixed-table-pagination .dropdown-toggle",
                    );
                    if (toggle) {
                        e.preventDefault();
                        e.stopPropagation();
                        const dropdown = toggle.closest(".dropdown");
                        if (dropdown) {
                            document
                                .querySelectorAll(".fixed-table-pagination .dropdown.show")
                                .forEach(function (d) {
                                    if (d !== dropdown) d.classList.remove("show");
                                });
                            dropdown.classList.toggle("show");
                        }
                        return;
                    }

                    if (!e.target.closest(".fixed-table-pagination .dropdown")) {
                        document
                            .querySelectorAll(".fixed-table-pagination .dropdown.show")
                            .forEach(function (d) {
                                d.classList.remove("show");
                            });
                    }
                });
            });
        </script>
    </body>
</html>
