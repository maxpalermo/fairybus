{% extends "admin/layout.twig" %}

{% block page_styles %}
    <link rel="stylesheet" href="{{ asset('fairy-bus/css/pages/locations.css') }}?v=1">
{% endblock %}

{% block content %}
    <section class="fb-page">
        <div class="fb-page-header">
            <div>
                <h1 class="fb-page-title">Nazioni, Province e Città</h1>
                <p class="fb-page-subtitle">Consulta e gestisce gli indirizzi geografici.</p>
            </div>
            <div class="fb-page-actions">
                <span class="fb-muted fb-selected-count" id="locations-selected-count">0 selezionati</span>
                <button type="button" class="fb-btn-icon fb-btn-icon-info" data-action="run-filters" title="Cerca: applica i filtri della scheda attiva">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                </button>
                <button type="button" class="fb-btn-icon fb-btn-icon-warning" data-action="print-locations" title="Stampa PDF della scheda attiva (righe selezionate, max 500)">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 6 2 18 2 18 9"></polyline><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path><rect x="6" y="14" width="12" height="8"></rect></svg>
                </button>
            </div>
        </div>

        <div class="fb-tabs">
            <button type="button" class="fb-tab active" data-tab="countries">Nazioni</button>
            <button type="button" class="fb-tab" data-tab="states">Province</button>
            <button type="button" class="fb-tab" data-tab="cities">Città</button>
        </div>

        <div class="fb-tab-panels">
            <div class="fb-tab-panel active" data-panel="countries">
                <div class="fb-table-wrap">
                    <table id="countries-table" class="fb-table"></table>
                </div>
            </div>

            <div class="fb-tab-panel" data-panel="states">
                <div class="fb-filter-bar">
                    <label class="fb-form-label" for="state-country-filter">Nazione</label>
                    <select id="state-country-filter" class="fb-form-input">
                        <option value="">Tutte</option>
                    </select>
                </div>
                <div class="fb-table-wrap">
                    <table id="states-table" class="fb-table"></table>
                </div>
            </div>

            <div class="fb-tab-panel" data-panel="cities">
                <div class="fb-filter-bar">
                    <label class="fb-form-label" for="city-state-filter">Provincia</label>
                    <select id="city-state-filter" class="fb-form-input">
                        <option value="">Tutte</option>
                    </select>
                    <input type="text" id="city-search" class="fb-form-input" placeholder="Cerca per città o CAP...">
                </div>
                <div class="fb-table-wrap">
                    <table id="cities-table" class="fb-table"></table>
                </div>
            </div>
        </div>
    </section>
{% endblock %}

{% block page_scripts %}
    <script type="module" src="{{ asset('fairy-bus/js/pages/locations.js') }}?v=2"></script>
{% endblock %}
