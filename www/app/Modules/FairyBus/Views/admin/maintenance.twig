{% extends "admin/layout.twig" %}

{% block page_styles %}
    <link rel="stylesheet" href="{{ asset('fairy-bus/css/pages/maintenance.css') }}">
{% endblock %}

{% block content %}
    <section class="fb-page">
        <div class="fb-page-header">
            <div>
                <h1 class="fb-page-title">Manutenzione</h1>
                <p class="fb-page-subtitle">Interventi di manutenzione e tagliandi sui veicoli.</p>
            </div>
            <div class="fb-page-actions">
                <span class="fb-muted fb-selected-count" id="maintenance-selected-count">0 selezionati</span>
                <button type="button" class="fb-btn-icon fb-btn-icon-warning" data-action="print-maintenance" title="Stampa PDF (righe selezionate, max 500)">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 6 2 18 2 18 9"></polyline><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path><rect x="6" y="14" width="12" height="8"></rect></svg>
                </button>
                <button type="button" class="fb-btn-icon fb-btn-icon-success" data-action="new-maintenance" title="Nuova manutenzione">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                </button>
            </div>
        </div>

        <div class="fb-table-wrap">
            <table id="maintenance-table" class="fb-table"></table>
        </div>
    </section>

    <template id="tpl-maintenance-form">
        <form class="fb-form fb-maintenance-form" data-form="maintenance">
            <input type="hidden" name="id_maintenance" value="">

            <div class="fb-tabs fb-form-tabs" role="tablist">
                <button type="button" class="fb-tab active" data-tab="info" role="tab" aria-selected="true">Informazioni</button>
                <button type="button" class="fb-tab" data-tab="ricambi" role="tab" aria-selected="false">Ricambi</button>
                <button type="button" class="fb-tab" data-tab="fatture" role="tab" aria-selected="false">Fatture</button>
            </div>

            <div class="fb-tab-panel active" data-panel="info" role="tabpanel">
                <div class="fb-form-group">
                    <label class="fb-form-label" for="mnt_vehicle">Veicolo</label>
                    <select id="mnt_vehicle" name="id_vehicle" class="fb-form-input" data-field="vehicle" required></select>
                </div>
                <div class="fb-form-grid">
                    <div class="fb-form-group">
                        <label class="fb-form-label" for="mnt_date">Data</label>
                        <input type="date" id="mnt_date" name="date" class="fb-form-input">
                    </div>
                    <div class="fb-form-group">
                        <label class="fb-form-label" for="mnt_km">Km veicolo</label>
                        <input type="number" id="mnt_km" name="km" class="fb-form-input" min="0" step="1" placeholder="Aggiorna i km dell'automezzo">
                    </div>
                </div>
                <div class="fb-form-group">
                    <label class="fb-form-label" for="mnt_task_desc">Lavoro eseguito</label>
                    <input type="text" id="mnt_task_desc" name="task_description" class="fb-form-input" maxlength="255">
                </div>
                <div class="fb-form-grid fb-form-grid-3">
                    <div class="fb-form-group">
                        <label class="fb-form-label" for="mnt_hours">Ore</label>
                        <input type="number" id="mnt_hours" name="hours" class="fb-form-input" min="0" step="1">
                    </div>
                    <div class="fb-form-group">
                        <label class="fb-form-label" for="mnt_manpower">Manodopera</label>
                        <input type="number" id="mnt_manpower" name="manpower" class="fb-form-input" min="0" step="0.01">
                    </div>
                    <div class="fb-form-group">
                        <label class="fb-form-label" for="mnt_price_hour">Prezzo orario</label>
                        <input type="number" id="mnt_price_hour" name="price_per_hour" class="fb-form-input" min="0" step="0.01">
                    </div>
                </div>
                <div class="fb-form-group">
                    <label class="fb-form-label" for="mnt_note">Nota</label>
                    <input type="text" id="mnt_note" name="note" class="fb-form-input" maxlength="255">
                </div>
            </div>

            <div class="fb-tab-panel" data-panel="ricambi" role="tabpanel">
                <div class="fb-kpi-grid">
                    <div class="fb-kpi fb-kpi-success">
                        <span class="fb-kpi-value" data-kpi="total">0,00 €</span>
                        <span class="fb-kpi-label">Prezzo totale</span>
                    </div>
                    <div class="fb-kpi fb-kpi-danger">
                        <span class="fb-kpi-value" data-kpi="qty">0</span>
                        <span class="fb-kpi-label">Pezzi usati</span>
                    </div>
                    <div class="fb-kpi fb-kpi-warning">
                        <span class="fb-kpi-value" data-kpi="rows">0</span>
                        <span class="fb-kpi-label">Numero movimenti</span>
                    </div>
                </div>

                <div class="fb-details-scroll">
                    <table class="fb-table fb-details-table">
                        <thead>
                            <tr>
                                <th class="num">Q.tà</th>
                                <th>Codice</th>
                                <th>Articolo</th>
                                <th class="num">Prezzo</th>
                                <th class="num">Sconto/ricarico</th>
                                <th class="num">Importo</th>
                                <th>I.v.a.</th>
                                <th class="num">Totale</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody data-field="details-body"></tbody>
                    </table>
                </div>

                <div class="fb-detail-add" data-field="detail-add">
                    <select class="fb-form-input" data-field="detail-product"></select>
                    <input type="number" class="fb-form-input" data-field="detail-qty" placeholder="Q.tà" step="0.001" min="0">
                    <input type="number" class="fb-form-input" data-field="detail-price" placeholder="Prezzo" step="0.0001" min="0">
                    <input type="number" class="fb-form-input" data-field="detail-discount" placeholder="Sconto %" step="0.01">
                    <input type="number" class="fb-form-input" data-field="detail-vat" placeholder="IVA %" step="0.01" min="0">
                    <button type="button" class="fb-btn fb-btn-secondary fb-btn-sm" data-action="add-detail">Aggiungi</button>
                </div>
                <p class="fb-muted fb-detail-hint" data-field="detail-hint">Salva prima la manutenzione per aggiungere i ricambi. I pezzi aggiunti vengono scaricati dal magazzino.</p>
            </div>

            <div class="fb-tab-panel" data-panel="fatture" role="tabpanel">
                <p class="fb-muted" data-field="invoices-hint">Salva prima la manutenzione per collegare le fatture.</p>
                <div data-field="invoices-wrap" hidden>
                    <div class="fb-details-scroll">
                        <table class="fb-table fb-details-table">
                            <thead>
                                <tr>
                                    <th>Numero</th>
                                    <th>Data</th>
                                    <th>Partner</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody data-field="invoices-body"></tbody>
                        </table>
                    </div>
                    <div class="fb-detail-add fb-invoice-add">
                        <select class="fb-form-input" data-field="invoice-select"></select>
                        <button type="button" class="fb-btn fb-btn-secondary fb-btn-sm" data-action="link-invoice">Collega fattura</button>
                    </div>
                </div>
            </div>

            <div class="fb-form-actions">
                <button type="submit" class="fb-btn fb-btn-primary">Salva</button>
                <button type="button" class="fb-btn fb-btn-secondary" data-action="close">Annulla</button>
            </div>
        </form>
    </template>
{% endblock %}

{% block page_scripts %}
    <script type="module" src="{{ asset('fairy-bus/js/pages/maintenance.js') }}"></script>
{% endblock %}
