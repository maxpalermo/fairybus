{% extends "admin/layout.twig" %}

{% block page_styles %}
    <link rel="stylesheet" href="{{ asset('fairy-bus/css/pages/stocks.css') }}">
{% endblock %}

{% block content %}
    <section class="fb-page">
        <div class="fb-page-header">
            <div>
                <h1 class="fb-page-title">Giacenze</h1>
                <p class="fb-page-subtitle">Quantità disponibili a magazzino per ogni articolo.</p>
            </div>
            <div class="fb-page-actions">
                <span class="fb-muted fb-selected-count" id="stocks-selected-count">0 selezionati</span>
                <button type="button" class="fb-btn fb-btn-secondary" data-action="print-stocks">Stampa PDF</button>
            </div>
        </div>

        <div class="fb-table-wrap">
            <table id="stocks-table" class="fb-table"></table>
        </div>
    </section>

    <template id="tpl-stock-form">
        <form class="fb-form" data-form="stock">
            <input type="hidden" name="id_stock" value="">
            <div class="fb-stock-product" data-field="product-label"></div>
            <div class="fb-form-grid">
                <div class="fb-form-group">
                    <label class="fb-form-label" for="stock_quantity">Quantità</label>
                    <input type="number" id="stock_quantity" name="quantity" class="fb-form-input" step="0.001" min="0" value="0">
                </div>
                <div class="fb-form-group">
                    <label class="fb-form-label" for="stock_unit">Unità di misura</label>
                    <select id="stock_unit" name="unit" class="fb-form-input">
                        <option value="0">Pezzi</option>
                        <option value="1">Metri</option>
                        <option value="2">Litri</option>
                    </select>
                </div>
                <div class="fb-form-group">
                    <label class="fb-form-label" for="stock_limit">Soglia di avviso</label>
                    <input type="number" id="stock_limit" name="notification_limit" class="fb-form-input" step="0.001" min="0" placeholder="Vuoto = nessun avviso">
                </div>
                <div class="fb-form-group">
                    <label class="fb-form-label" for="stock_note">Nota</label>
                    <input type="text" id="stock_note" name="note" class="fb-form-input" maxlength="255">
                </div>
            </div>
            <div class="fb-form-actions">
                <button type="submit" class="fb-btn fb-btn-primary">Salva</button>
                <button type="button" class="fb-btn fb-btn-secondary" data-action="close">Annulla</button>
            </div>
        </form>
    </template>
{% endblock %}

{% block page_scripts %}
    <script type="module" src="{{ asset('fairy-bus/js/pages/stocks.js') }}"></script>
{% endblock %}
