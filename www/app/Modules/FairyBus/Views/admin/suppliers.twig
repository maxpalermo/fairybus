{% extends "admin/layout.twig" %}

{% block page_styles %}
    <link rel="stylesheet" href="{{ asset('fairy-bus/css/pages/suppliers.css') }}?v=1">
{% endblock %}

{% block content %}
    <section class="fb-page">
        <div class="fb-page-header">
            <div>
                <h1 class="fb-page-title">Fornitori</h1>
                <p class="fb-page-subtitle">Elenco fornitori importati e gestiti.</p>
            </div>
            <div class="fb-page-actions">
                <span class="fb-muted fb-selected-count" id="suppliers-selected-count">0 selezionati</span>
                <button type="button" class="fb-btn-icon fb-btn-icon-info" data-action="run-filters" title="Cerca: applica i filtri delle colonne">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                </button>
                <button type="button" class="fb-btn-icon fb-btn-icon-warning" data-action="print-suppliers" title="Stampa PDF (righe selezionate, max 500)">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 6 2 18 2 18 9"></polyline><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path><rect x="6" y="14" width="12" height="8"></rect></svg>
                </button>
                <button type="button" class="fb-btn-icon fb-btn-icon-success" data-action="new-supplier" title="Nuovo fornitore">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                </button>
            </div>
        </div>

        <div class="fb-table-wrap">
            <table id="suppliers-table" class="fb-table"></table>
        </div>
    </section>

    <template id="tpl-supplier-form">
        <form class="fb-form fb-supplier-form" data-form="supplier">
            <input type="hidden" name="id_supplier" value="">

            <p class="fb-form-section">Anagrafica</p>
            <div class="fb-form-group">
                <label class="fb-form-label" for="sup_company">Ragione sociale*</label>
                <input type="text" id="sup_company" name="company" class="fb-form-input" maxlength="255" required>
            </div>
            <div class="fb-form-grid">
                <div class="fb-form-group">
                    <label class="fb-form-label" for="sup_vat">P. IVA / CF</label>
                    <input type="text" id="sup_vat" name="vat_number" class="fb-form-input" maxlength="64">
                </div>
                <div class="fb-form-group">
                    <label class="fb-form-label" for="sup_contact">Referente</label>
                    <input type="text" id="sup_contact" name="contact_name" class="fb-form-input" maxlength="255">
                </div>
            </div>

            <p class="fb-form-section">Contatti</p>
            <div class="fb-form-grid">
                <div class="fb-form-group">
                    <label class="fb-form-label" for="sup_email">Email</label>
                    <input type="email" id="sup_email" name="email" class="fb-form-input" maxlength="255">
                </div>
                <div class="fb-form-group">
                    <label class="fb-form-label" for="sup_pec">PEC</label>
                    <input type="email" id="sup_pec" name="pec" class="fb-form-input" maxlength="255">
                </div>
            </div>
            <div class="fb-form-grid">
                <div class="fb-form-group">
                    <label class="fb-form-label" for="sup_phone">Telefono</label>
                    <input type="text" id="sup_phone" name="phone_number" class="fb-form-input" maxlength="64">
                </div>
                <div class="fb-form-group">
                    <label class="fb-form-label" for="sup_mobile">Cellulare</label>
                    <input type="text" id="sup_mobile" name="mobile_number" class="fb-form-input" maxlength="64">
                </div>
            </div>

            <p class="fb-form-section">Indirizzo</p>
            <div class="fb-form-grid">
                <div class="fb-form-group">
                    <label class="fb-form-label" for="sup_address1">Indirizzo</label>
                    <input type="text" id="sup_address1" name="address1" class="fb-form-input" maxlength="255">
                </div>
                <div class="fb-form-group">
                    <label class="fb-form-label" for="sup_address2">Indirizzo 2</label>
                    <input type="text" id="sup_address2" name="address2" class="fb-form-input" maxlength="255">
                </div>
            </div>
            <div class="fb-form-grid">
                <div class="fb-form-group">
                    <label class="fb-form-label" for="sup_city">Città</label>
                    <input type="text" id="sup_city" name="city" class="fb-form-input" maxlength="255">
                </div>
                <div class="fb-form-group">
                    <label class="fb-form-label" for="sup_postcode">CAP</label>
                    <input type="text" id="sup_postcode" name="postcode" class="fb-form-input" maxlength="16">
                </div>
            </div>

            <p class="fb-form-section">Stato</p>
            <div class="fb-form-grid">
                <label class="fb-switch fb-switch-info">
                    <input type="checkbox" name="fuel" value="1">
                    <span class="fb-switch-slider"></span>
                    <span class="fb-switch-text">Fornitore di carburante</span>
                </label>
                <label class="fb-switch fb-switch-success">
                    <input type="checkbox" name="active" value="1" checked>
                    <span class="fb-switch-slider"></span>
                    <span class="fb-switch-text">Fornitore attivo</span>
                </label>
            </div>

            <div class="fb-form-actions">
                <button type="submit" class="fb-btn fb-btn-primary">Salva</button>
                <button type="button" class="fb-btn fb-btn-secondary" data-action="close">Annulla</button>
            </div>
        </form>
    </template>
{% endblock %}

{% block page_scripts %}
    <script type="module" src="{{ asset('fairy-bus/js/pages/suppliers.js') }}?v=3"></script>
{% endblock %}
