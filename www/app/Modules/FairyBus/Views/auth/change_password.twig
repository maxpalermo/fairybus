{% extends "admin/layout.twig" %}

{% block page_styles %}
    <link rel="stylesheet" href="{{ asset('fairy-bus/css/pages/login.css') }}">
{% endblock %}

{% block content %}
    <section class="fb-page" style="padding: 1.5rem;">
        <h1 style="margin: 0 0 1rem; font-size: 1.25rem; font-weight: 700;">Primo accesso</h1>

        <div style="display: flex; gap: 0.25rem; border-bottom: 1px solid var(--fb-border); margin-bottom: 1rem;">
            <button type="button" style="padding: 0.5rem 0.75rem; font-size: 0.8125rem; font-weight: 500; border: none; background: transparent; border-bottom: 2px solid var(--fb-foreground); color: var(--fb-foreground);">Password</button>
        </div>

        <div class="fb-login-card" style="margin: 0 auto;" aria-labelledby="change-password-title">
            <div class="fb-login-header">
                <h1 id="change-password-title">Cambia password</h1>
                <p>Per motivi di sicurezza devi impostare una nuova password.</p>
            </div>

            {% if error %}
                <div class="fb-alert fb-alert-error" role="alert">
                    {{ error }}
                </div>
            {% endif %}

            {% if success %}
                <div class="fb-alert fb-alert-success" role="status">
                    {{ success }}
                </div>
            {% endif %}

            <form method="post" action="{{ base_url('change-password') }}" novalidate>
                <input type="hidden" name="{{ csrf.name }}" value="{{ csrf.value }}">

                <div class="fb-form-group">
                    <label for="current_password" class="fb-form-label">Password attuale</label>
                    <div class="fb-input-group">
                        <input type="password" id="current_password" name="current_password" class="fb-form-input" required autofocus>
                        <button type="button" class="fb-input-toggle" data-toggle-password="current_password" aria-label="Mostra password">
                            <svg class="icon-eye" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                <circle cx="12" cy="12" r="3"></circle>
                            </svg>
                            <svg class="icon-eye-off" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display: none;">
                                <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-3.72.72L3 3"></path>
                            </svg>
                        </button>
                    </div>
                </div>

                <div class="fb-form-group">
                    <label for="new_password" class="fb-form-label">Nuova password</label>
                    <div class="fb-input-group">
                        <input type="password" id="new_password" name="new_password" class="fb-form-input" required minlength="6">
                        <button type="button" class="fb-input-toggle" data-toggle-password="new_password" aria-label="Mostra password">
                            <svg class="icon-eye" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                <circle cx="12" cy="12" r="3"></circle>
                            </svg>
                            <svg class="icon-eye-off" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display: none;">
                                <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-3.72.72L3 3"></path>
                            </svg>
                        </button>
                    </div>
                </div>

                <div class="fb-form-group">
                    <label for="confirm_password" class="fb-form-label">Conferma nuova password</label>
                    <div class="fb-input-group">
                        <input type="password" id="confirm_password" name="confirm_password" class="fb-form-input" required>
                        <button type="button" class="fb-input-toggle" data-toggle-password="confirm_password" aria-label="Mostra password">
                            <svg class="icon-eye" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                <circle cx="12" cy="12" r="3"></circle>
                            </svg>
                            <svg class="icon-eye-off" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display: none;">
                                <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-3.72.72L3 3"></path>
                            </svg>
                        </button>
                    </div>
                </div>

                <button type="submit" class="fb-btn fb-btn-primary fb-login-submit">
                    Aggiorna password
                </button>
            </form>
        </div>
    </section>
{% endblock %}

{% block page_scripts %}
    <script type="module">
        import PasswordToggle from "{{ asset('fairy-bus/js/core/PasswordToggle.js') }}";
        PasswordToggle.init();
    </script>
{% endblock %}
