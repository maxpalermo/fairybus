{% extends "print/layout.twig" %}

{% block content %}
    <table class="data">
        <thead>
            <tr>
                <th style="width: 8%;" class="center">ID</th>
                <th>Categoria</th>
                <th style="width: 25%;">Padre</th>
                <th style="width: 8%;" class="center">Pos.</th>
                <th style="width: 10%;" class="center">Attiva</th>
            </tr>
        </thead>
        <tbody>
            {% for row in rows %}
                <tr>
                    <td class="center muted">{{ row.id_category }}</td>
                    <td>{{ row.name|default('—') }}</td>
                    <td class="muted">{{ row.parent_name|default('—') }}</td>
                    <td class="center">{{ row.position }}</td>
                    <td class="center{% if row.active != 1 %} low{% endif %}">{% if row.active == 1 %}Sì{% else %}No{% endif %}</td>
                </tr>
            {% else %}
                <tr><td colspan="5" class="center muted">Nessuna categoria presente.</td></tr>
            {% endfor %}
        </tbody>
    </table>
{% endblock %}

{% block footer %}
    <span>{{ app_name|default('Fairy Bus') }} — {{ title|default('Documento') }} — Elementi: {{ rows|length }}</span>
{% endblock %}
