 # Stampa del singolo documento di carico con righe dettaglio.
#}
{% extends "print/layout.twig" %}

{% block content %}
    {% set is_out = document.id_customer is not empty %}
    <table class="data" style="margin-bottom: 14pt;">
        <tbody>
            <tr>
                <td style="width: 18%;" class="muted">{{ is_out ? 'Destinatario' : 'Fornitore' }}</td>
                <td colspan="3"><strong>{{ document.customer_name|default(document.supplier_name)|default('—') }}</strong></td>
            </tr>
            {% if document.vehicle_plate %}
                <tr>
                    <td class="muted">Targa</td>
                    <td colspan="3">{{ document.vehicle_plate }}</td>
                </tr>
            {% endif %}
            <tr>
                <td class="muted">Numero</td>
                <td>{{ document.number|default('—') }}</td>
                <td style="width: 12%;" class="muted">Data</td>
                <td>{{ document.date ? document.date|date('d/m/Y') : '—' }}</td>
            </tr>
            <tr>
                <td class="muted">Tipo</td>
                <td {{ is_out ? 'colspan="3"' : '' }}>{{ document.type_name|default('—') }}</td>
                {% if not is_out %}
                    <td class="muted">Fattura</td>
                    <td>{{ document.invoice_number|default('—') }}</td>
                {% endif %}
            </tr>
            {% if document.note %}
                <tr>
                    <td class="muted">Nota</td>
                    <td colspan="3">{{ document.note }}</td>
                </tr>
            {% endif %}
        </tbody>
    </table>

    {% set colw = is_out ? {qty: 6, code: 12, price: 10, disc: 7, amount: 10, vat: 8, tot: 10} : {qty: 8, code: 15, price: 11, disc: 9, amount: 12, vat: 10, tot: 12} %}
    <table class="data">
        <thead>
            <tr>
                {% if is_out %}<th style="width: 19%;">Scheda</th>{% endif %}
                <th style="width: {{ colw.qty }}%;" class="num">Q.tà</th>
                <th style="width: {{ colw.code }}%;">Codice</th>
                <th>Articolo</th>
                <th style="width: {{ colw.price }}%;" class="num">Prezzo</th>
                <th style="width: {{ colw.disc }}%;" class="num">Sconto</th>
                <th style="width: {{ colw.amount }}%;" class="num">Importo</th>
                <th style="width: {{ colw.vat }}%;">I.v.a.</th>
                <th style="width: {{ colw.tot }}%;" class="num">Totale</th>
            </tr>
        </thead>
        <tbody>
            {% set total = 0 %}
            {% set totalQty = 0 %}
            {% for row in document.details %}
                {% set importo = row.quantity|abs * row.price * (1 - (row.discount|default(0)|abs) / 100) %}
                {% set vat = row.vat_rate is not null ? row.vat_rate : 0 %}
                {% set rowTotal = importo * (1 + vat / 100) %}
                {% set total = total + rowTotal %}
                {% set totalQty = totalQty + row.quantity|abs %}
                <tr>
                    {% if is_out %}<td>{{ row.id_maintenance ? 'Scheda ' ~ row.id_maintenance ~ (row.maintenance_date ? ' del ' ~ row.maintenance_date|date('d/m/Y') : '') : '—' }}</td>{% endif %}
                    <td class="num">{{ row.quantity|abs|number_format(3, ',', '.')|trim('0', 'right')|trim(',', 'right') ?: '0' }}</td>
                    <td>{{ row.sku|default('—') }}</td>
                    <td>{{ row.product_name|default('—') }}</td>
                    <td class="num">&nbsp;{{ row.price|eur }}</td>
                    <td class="num">{{ row.discount|default(0)|abs|number_format(0) }}%</td>
                    <td class="num">&nbsp;{{ importo|eur }}</td>
                    <td>{{ row.vat_code is not empty ? (row.vat_code|number_format(2, ',', '.') ~ '%') : (row.vat_rate is not null ? row.vat_rate|number_format(2, ',', '.') ~ '%' : '—') }}</td>
                    <td class="num">&nbsp;{{ rowTotal|eur }}</td>
                </tr>
            {% else %}
                {% if empty_sheets is not defined or empty_sheets is empty %}
                    <tr><td colspan="{{ is_out ? 9 : 8 }}" class="center muted">Nessun movimento.</td></tr>
                {% endif %}
            {% endfor %}
            {% if is_out %}
                {# Schede collegate al riepilogo senza righe movimento (?empty=1) #}
                {% for s in empty_sheets|default([]) %}
                    <tr>
                        <td>Scheda {{ s.id_maintenance }}{{ s.date ? ' del ' ~ s.date|date('d/m/Y') : '' }}</td>
                        <td colspan="8" class="center muted">Nessun movimento</td>
                    </tr>
                {% endfor %}
            {% endif %}
        </tbody>
        {% if document.details|length > 0 %}
            <tfoot>
                <tr>
                    {% if is_out %}<td style="border-top: 1.5pt solid #18181b;"></td>{% endif %}
                    <td class="num" style="border-top: 1.5pt solid #18181b;"><strong>{{ totalQty|number_format(3, ',', '.')|trim('0', 'right')|trim(',', 'right') ?: '0' }}</strong></td>
                    <td colspan="4" style="border-top: 1.5pt solid #18181b;"></td>
                    <td class="muted" style="border-top: 1.5pt solid #18181b;">Totale documento</td>
                    <td style="border-top: 1.5pt solid #18181b;"></td>
                    <td class="num" style="border-top: 1.5pt solid #18181b;"><strong>&nbsp;{{ total|eur }}</strong></td>
                </tr>
            </tfoot>
        {% endif %}
    </table>
{% endblock %}

{% block footer %}
    <span>{{ app_name|default('Fairy Bus') }} — {{ title|default('Documento') }} — Righe: {{ document.details|length }}</span>
{% endblock %}
