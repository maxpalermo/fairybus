{% extends "print/layout.twig" %}

{% block content %}
    <table class="data">
        <thead>
            <tr>
                <th style="width: 7%;" class="center">ID</th>
                <th style="width: 12%;">Data</th>
                <th style="width: 15%;">Numero</th>
                <th>Fornitore / Cliente</th>
                <th style="width: 12%;">Tipo</th>
                <th style="width: 15%;">Fattura</th>
                <th>Note</th>
            </tr>
        </thead>
        <tbody>
            {% for row in rows %}
                <tr>
                    <td class="center muted">{{ row.id_document }}</td>
                    <td>{{ row.date ? row.date|date('d/m/Y') : '—' }}</td>
                    <td>{{ row.number|default('—') }}</td>
                    <td>{{ row.supplier_name|default(row.customer_name)|default('—') }}</td>
                    <td>{{ row.type_name|default('—') }}</td>
                    <td>{{ row.invoice_number|default('—') }}</td>
                    <td class="muted">{{ row.note|default('—') }}</td>
                </tr>
            {% else %}
                <tr><td colspan="7" class="center muted">Nessun documento presente.</td></tr>
            {% endfor %}
        </tbody>
    </table>
{% endblock %}

{% block footer %}
    <span>{{ app_name|default('Fairy Bus') }} — {{ title|default('Documento') }} — Elementi: {{ rows|length }}</span>
{% endblock %}
