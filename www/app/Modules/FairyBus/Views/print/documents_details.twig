 # Stampa dettagliata di piu' documenti: scheda completa per ciascuno,
 # poi riepilogo articoli aggregato.
#}
{% extends "print/layout.twig" %}

{% block content %}
    {% for document in documents %}
        <div{% if not loop.last %} style="page-break-after: always;"{% endif %}>
        <h3 style="margin: 0 0 6pt 0; font-size: 12pt;">
            Documento {{ document.number|default('#' ~ document.id_document) }} — {{ document.supplier_name|default(document.customer_name)|default('—') }}
        </h3>
        <table class="data" style="margin-bottom: 14pt;">
            <tbody>
                <tr>
                    <td style="width: 18%;" class="muted">{{ document.id_customer ? 'Cliente' : 'Fornitore' }}</td>
                    <td><strong>{{ document.supplier_name|default(document.customer_name)|default('—') }}</strong></td>
                    <td style="width: 12%;" class="muted">Numero</td>
                    <td>{{ document.number|default('—') }}</td>
                </tr>
                <tr>
                    <td class="muted">Data</td>
                    <td>{{ document.date ? document.date|date('d/m/Y') : '—' }}</td>
                    {% if document.id_customer %}
                        <td class="muted">Targa</td>
                        <td>{{ document.vehicle_plate|default('—') }}</td>
                    {% else %}
                        <td class="muted">Fattura</td>
                        <td>{{ document.invoice_number|default('—') }}</td>
                    {% endif %}
                </tr>
                <tr>
                    <td class="muted">Tipo</td>
                    <td colspan="3">{{ document.type_name|default('—') }}</td>
                </tr>
                {% if document.note %}
                    <tr>
                        <td class="muted">Nota</td>
                        <td colspan="3">{{ document.note }}</td>
                    </tr>
                {% endif %}
            </tbody>
        </table>

        <table class="data">
            <thead>
                <tr>
                    <th style="width: 8%;" class="num">Q.tà</th>
                    <th style="width: 15%;">Codice</th>
                    <th>Articolo</th>
                    <th style="width: 11%;" class="num">Prezzo</th>
                    <th style="width: 9%;" class="num">Sconto</th>
                    <th style="width: 12%;" class="num">Importo</th>
                    <th style="width: 10%;">I.v.a.</th>
                    <th style="width: 12%;" class="num">Totale</th>
                </tr>
            </thead>
            <tbody>
                {% set total = 0 %}
                {% set totalQty = 0 %}
                {% for row in document.details %}
                    {% set qty = row.quantity|abs %}
                    {% set importo = qty * row.price * (1 - (row.discount|default(0)|abs) / 100) %}
                    {% set vat = row.vat_rate is not null ? row.vat_rate : 0 %}
                    {% set rowTotal = importo * (1 + vat / 100) %}
                    {% set total = total + rowTotal %}
                    {% set totalQty = totalQty + qty %}
                    <tr>
                        <td class="num">{{ qty|number_format(3, ',', '.')|trim('0', 'right')|trim(',', 'right') ?: '0' }}</td>
                        <td>{{ row.sku|default('—') }}</td>
                        <td>{{ row.product_name|default('—') }}</td>
                        <td class="num">&nbsp;{{ row.price|number_format(2, ',', '.') }}</td>
                        <td class="num">{{ row.discount|default(0)|abs|number_format(0) }}%</td>
                        <td class="num">&nbsp;{{ importo|number_format(2, ',', '.') }}</td>
                        <td>{% if row.vat_rate is not null or row.vat_code is not null %}{{ (row.vat_rate ?? row.vat_code)|number_format(2, ',', '.') }}%{% else %}—{% endif %}</td>
                        <td class="num">&nbsp;{{ rowTotal|number_format(2, ',', '.') }}</td>
                    </tr>
                {% else %}
                    <tr><td colspan="8" class="center muted">Nessun movimento.</td></tr>
                {% endfor %}
            </tbody>
            {% if document.details|length > 0 %}
                <tfoot>
                    <tr>
                        <td class="num" style="border-top: 1.5pt solid #18181b;"><strong>{{ totalQty|number_format(3, ',', '.')|trim('0', 'right')|trim(',', 'right') ?: '0' }}</strong></td>
                        <td colspan="4" style="border-top: 1.5pt solid #18181b;"></td>
                        <td class="muted" style="border-top: 1.5pt solid #18181b;">Totale documento</td>
                        <td style="border-top: 1.5pt solid #18181b;"></td>
                        <td class="num" style="border-top: 1.5pt solid #18181b;"><strong>&nbsp;{{ total|number_format(2, ',', '.') }}</strong></td>
                    </tr>
                </tfoot>
            {% endif %}
        </table>
        </div>
    {% endfor %}

    {% if documents|length > 1 %}
        <div style="page-break-before: always;">
            <h3 style="margin: 0 0 6pt 0; font-size: 12pt;">Riepilogo articoli</h3>
            <table class="data">
                <thead>
                    <tr>
                        <th style="width: 15%;">Codice</th>
                        <th>Articolo</th>
                        <th style="width: 10%;" class="num">Q.tà</th>
                        <th style="width: 13%;" class="num">Prezzo medio</th>
                        <th style="width: 14%;" class="num">Imponibile</th>
                        <th style="width: 14%;" class="num">Totale ivato</th>
                    </tr>
                </thead>
                <tbody>
                    {% for row in summary %}
                        <tr>
                            <td>{{ row.sku }}</td>
                            <td>{{ row.product_name }}</td>
                            <td class="num">{{ row.qty|abs|number_format(3, ',', '.')|trim('0', 'right')|trim(',', 'right') ?: '0' }}</td>
                            <td class="num">&nbsp;{{ (row.qty > 0 ? row.amount / row.qty : 0)|number_format(2, ',', '.') }}</td>
                            <td class="num">&nbsp;{{ row.amount|number_format(2, ',', '.') }}</td>
                            <td class="num">&nbsp;{{ row.total|number_format(2, ',', '.') }}</td>
                        </tr>
                    {% else %}
                        <tr><td colspan="6" class="center muted">Nessun articolo.</td></tr>
                    {% endfor %}
                </tbody>
                {% if summary|length > 0 %}
                    <tfoot>
                        <tr>
                            <td colspan="4" style="border-top: 1.5pt solid #18181b;"></td>
                            <td class="muted" style="border-top: 1.5pt solid #18181b;">Totale generale</td>
                            <td class="num" style="border-top: 1.5pt solid #18181b;"><strong>&nbsp;{{ grand_total|number_format(2, ',', '.') }}</strong></td>
                        </tr>
                    </tfoot>
                {% endif %}
            </table>
        </div>
    {% endif %}
{% endblock %}

{% block footer %}
    <span>{{ app_name|default('Fairy Bus') }} — {{ title|default('Dettaglio documenti') }} — Documenti: {{ documents|length }}</span>
{% endblock %}
