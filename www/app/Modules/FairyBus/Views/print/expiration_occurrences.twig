{% extends "print/layout.twig" %}

{% block content %}
    <table class="data">
        <thead>
            <tr>
                <th style="width: 14%;">Veicolo</th>
                <th>Voce</th>
                <th style="width: 16%;" class="center">Scadenza</th>
                <th style="width: 14%;" class="right">Km attuali</th>
                <th style="width: 14%;" class="center">Stato</th>
            </tr>
        </thead>
        <tbody>
            {% for row in rows %}
                <tr>
                    <td>{{ row.vehicle_plate|default('—') }}</td>
                    <td>{{ row.tag_name|default(row.description|default('—')) }}</td>
                    <td class="center">
                        {% if row.expiration_date %}
                            {{ row.expiration_date|date('d/m/Y') }}
                        {% elseif row.km %}
                            {{ row.km|number_format(0, ',', '.') }} km
                        {% else %}
                            —
                        {% endif %}
                    </td>
                    <td class="right muted">
                        {% if row.current_km %}{{ row.current_km|number_format(0, ',', '.') }} km{% else %}—{% endif %}
                    </td>
                    <td class="center">{{ row.state_label|default('—') }}</td>
                </tr>
            {% else %}
                <tr><td colspan="5" class="center muted">Nessuna scadenza selezionata.</td></tr>
            {% endfor %}
        </tbody>
    </table>
{% endblock %}

{% block footer %}
    <span>{{ app_name|default('Fairy Bus') }} — {{ title|default('Scadenze veicoli') }} — Elementi: {{ rows|length }}</span>
{% endblock %}
