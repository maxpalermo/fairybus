{% extends "print/layout.twig" %}

{% block content %}
    <table class="data">
        <thead>
            <tr>
                <th style="width: 8%;" class="center">ID</th>
                <th>Nome</th>
                <th style="width: 12%;" class="center">Tipo</th>
                <th style="width: 18%;">Intervallo</th>
                <th style="width: 25%;">Applica a</th>
            </tr>
        </thead>
        <tbody>
            {% for row in rows %}
                <tr>
                    <td class="center muted">{{ row.id_expiration_tag }}</td>
                    <td>{{ row.name }}</td>
                    <td class="center">{{ row.kind == 'km' ? 'Km' : 'Data' }}</td>
                    <td>{{ row.interval_label|default('—') }}</td>
                    <td class="muted">{{ row.applies_to|default('—') }}</td>
                </tr>
            {% else %}
                <tr><td colspan="5" class="center muted">Nessuna voce di scadenza presente.</td></tr>
            {% endfor %}
        </tbody>
    </table>
{% endblock %}

{% block footer %}
    <span>{{ app_name|default('Fairy Bus') }} — {{ title|default('Voci di scadenza') }} — Elementi: {{ rows|length }}</span>
{% endblock %}
