{% extends "print/layout.twig" %}

{% block content %}
    <table class="data">
        <thead>
            <tr>
                <th style="width: 6%;" class="center">ID</th>
                <th style="width: 10%;">Data</th>
                <th style="width: 12%;">Targa</th>
                <th style="width: 15%;">Marca</th>
                <th style="width: 12%;" class="num">Km</th>
                <th>Note</th>
                <th style="width: 9%;" class="center">Fatture</th>
            </tr>
        </thead>
        <tbody>
            {% for row in rows %}
                <tr>
                    <td class="center muted">{{ row.id_maintenance }}</td>
                    <td>{{ row.date ? row.date|date('d/m/Y') : '—' }}</td>
                    <td>{{ row.vehicle_plate|default('—') }}</td>
                    <td>{{ row.brand_name|default('—') }}</td>
                    <td class="num">{{ row.km is not null ? row.km|number_format(0, ',', '.') ~ ' km' : '—' }}</td>
                    <td class="muted">{{ row.note|default('—') }}</td>
                    <td class="center">{{ row.invoices_count > 0 ? '✓' : '—' }}</td>
                </tr>
            {% else %}
                <tr><td colspan="7" class="center muted">Nessuna manutenzione presente.</td></tr>
            {% endfor %}
        </tbody>
    </table>
{% endblock %}

{% block footer %}
    <span>{{ app_name|default('Fairy Bus') }} — {{ title|default('Manutenzioni') }} — Elementi: {{ rows|length }}</span>
{% endblock %}
