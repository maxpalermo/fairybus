 # Stampa della singola manutenzione con lavoro e ricambi.
#}
{% extends "print/layout.twig" %}

{% block content %}
    <table class="data" style="margin-bottom: 14pt;">
        <tbody>
            <tr>
                <td style="width: 18%;" class="muted">Veicolo</td>
                <td><strong>{{ maintenance.vehicle_plate|default('—') }}</strong>{% if maintenance.brand_name %} — {{ maintenance.brand_name }}{% endif %}</td>
                <td style="width: 12%;" class="muted">Data</td>
                <td>{{ maintenance.date ? maintenance.date|date('d/m/Y') : '—' }}</td>
            </tr>
            <tr>
                <td class="muted">Km</td>
                <td>{{ maintenance.km is not null ? maintenance.km|number_format(0, ',', '.') ~ ' km' : '—' }}</td>
                <td class="muted">Fatture</td>
                <td>
                    {% for inv in maintenance.invoices %}
                        {{ inv.invoice_number|default('s.n.') }}{% if not loop.last %}, {% endif %}
                    {% else %}
                        —
                    {% endfor %}
                </td>
            </tr>
            {% if maintenance.note %}
                <tr>
                    <td class="muted">Nota</td>
                    <td colspan="3">{{ maintenance.note }}</td>
                </tr>
            {% endif %}
        </tbody>
    </table>

    {% if maintenance.tasks|length > 0 %}
        <h3 style="margin: 0 0 6pt 0; font-size: 11pt;">Lavoro eseguito</h3>
        <table class="data" style="margin-bottom: 14pt;">
            <thead>
                <tr>
                    <th>Descrizione</th>
                    <th style="width: 12%;" class="num">Ore</th>
                    <th style="width: 15%;" class="num">Manodopera</th>
                    <th style="width: 15%;" class="num">Prezzo orario</th>
                </tr>
            </thead>
            <tbody>
                {% for t in maintenance.tasks %}
                    <tr>
                        <td>{{ t.description|default('—') }}</td>
                        <td class="num">{{ t.hours }}</td>
                        <td class="num">{{ t.manpower|number_format(2, ',', '.') }}</td>
                        <td class="num">€ {{ t.price_per_hour|number_format(2, ',', '.') }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% endif %}

    <h3 style="margin: 0 0 6pt 0; font-size: 11pt;">Ricambi utilizzati</h3>
    <table class="data">
        <thead>
            <tr>
                <th style="width: 8%;" class="num">Q.tà</th>
                <th style="width: 15%;">Codice</th>
                <th>Articolo</th>
                <th style="width: 11%;" class="num">Prezzo</th>
                <th style="width: 9%;" class="num">Sconto</th>
                <th style="width: 12%;" class="num">Importo</th>
                <th style="width: 10%;">I.v.a.</th>
                <th style="width: 12%;" class="num">Totale</th>
            </tr>
        </thead>
        <tbody>
            {% set total = 0 %}
            {% set totalQty = 0 %}
            {% for row in maintenance.details %}
                {% set importo = row.quantity * row.price * (1 + (row.discount|default(0)) / 100) %}
                {% set vat = row.vat_rate is not null ? row.vat_rate : 0 %}
                {% set rowTotal = importo * (1 + vat / 100) %}
                {% set total = total + rowTotal %}
                {% set totalQty = totalQty + row.quantity %}
                <tr>
                    <td class="num">{{ row.quantity|number_format(3, ',', '.')|trim('0', 'right')|trim(',', 'right') ?: '0' }}</td>
                    <td>{{ row.sku|default('—') }}</td>
                    <td>{{ row.product_name|default('—') }}</td>
                    <td class="num">€ {{ row.price|number_format(2, ',', '.') }}</td>
                    <td class="num">{{ row.discount|number_format(0) }}%</td>
                    <td class="num">€ {{ importo|number_format(2, ',', '.') }}</td>
                    <td>{% if row.vat_code %}Aliquota {{ row.vat_code }}%{% elseif row.vat_rate is not null %}{{ row.vat_rate }}%{% else %}—{% endif %}</td>
                    <td class="num">€ {{ rowTotal|number_format(2, ',', '.') }}</td>
                </tr>
            {% else %}
                <tr><td colspan="8" class="center muted">Nessun ricambio.</td></tr>
            {% endfor %}
        </tbody>
        {% if maintenance.details|length > 0 %}
            <tfoot>
                <tr>
                    <td class="num" style="border-top: 1.5pt solid #18181b;"><strong>{{ totalQty|number_format(3, ',', '.')|trim('0', 'right')|trim(',', 'right') ?: '0' }}</strong></td>
                    <td colspan="4" style="border-top: 1.5pt solid #18181b;"></td>
                    <td class="muted" style="border-top: 1.5pt solid #18181b;">Totale ricambi</td>
                    <td style="border-top: 1.5pt solid #18181b;"></td>
                    <td class="num" style="border-top: 1.5pt solid #18181b;"><strong>€ {{ total|number_format(2, ',', '.') }}</strong></td>
                </tr>
            </tfoot>
        {% endif %}
    </table>
{% endblock %}

{% block footer %}
    <span>{{ app_name|default('Fairy Bus') }} — {{ title|default('Manutenzione') }} — Righe: {{ maintenance.details|length }}</span>
{% endblock %}
