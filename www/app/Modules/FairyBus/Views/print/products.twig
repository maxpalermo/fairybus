{% extends "print/layout.twig" %}

{% block content %}
    <table class="data">
        <thead>
            <tr>
                <th style="width: 13%;">SKU</th>
                <th>Nome</th>
                <th style="width: 14%;">Marca</th>
                <th style="width: 14%;">Categoria</th>
                <th style="width: 9%;" class="num">Prezzo</th>
                <th style="width: 6%;" class="center">IVA</th>
                <th style="width: 7%;" class="center">Attivo</th>
            </tr>
        </thead>
        <tbody>
            {% for row in rows %}
                <tr>
                    <td>{{ row.sku|default('—') }}</td>
                    <td>
                        {{ row.name|default('—') }}
                        {% if row.alias_sku %}<br><span class="muted">Alias di: {{ row.alias_sku }}</span>{% endif %}
                    </td>
                    <td class="muted">{{ row.brand_name|default('—') }}</td>
                    <td class="muted">{{ row.category_name|default('—') }}</td>
                    <td class="num">{% if row.price is not null %}&nbsp;{{ row.price|number_format(2, ',', '.') }}{% else %}—{% endif %}</td>
                    <td class="center">{% if row.tax_rate is not null %}{{ row.tax_rate|number_format(0) }}%{% else %}—{% endif %}</td>
                    <td class="center{% if row.active != 1 %} low{% endif %}">{% if row.active == 1 %}Sì{% else %}No{% endif %}</td>
                </tr>
            {% else %}
                <tr><td colspan="7" class="center muted">Nessun prodotto presente.</td></tr>
            {% endfor %}
        </tbody>
    </table>
{% endblock %}

{% block footer %}
    <span>{{ app_name|default('Fairy Bus') }} — {{ title|default('Documento') }} — Elementi: {{ rows|length }}</span>
{% endblock %}
