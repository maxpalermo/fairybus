{% extends "print/layout.twig" %}

{% block content %}
<table>
    <thead>
        <tr>
            <th>Data</th>
            <th>Automezzo</th>
            <th>Stazione</th>
            <th>Alimentazione</th>
            <th>Operazione</th>
            <th class="text-right">Litri</th>
            <th class="text-right">€/litro</th>
            <th class="text-right">Km</th>
            <th class="text-right">Km da ultimo</th>
            <th>Fornitore</th>
        </tr>
    </thead>
    <tbody>
        {% for row in rows %}
        <tr>
            <td>{{ row.refuel_time ? row.refuel_time|date('d/m/Y H:i') : '—' }}</td>
            <td>{{ row.vehicle_plate ?: '—' }}</td>
            <td>{{ row.station_name ?: '—' }}</td>
            <td>{{ row.fuel_type_name ?: '—' }}</td>
            <td class="text-center">{{ row.direction == 'in' ? 'Carico' : 'Scarico' }}</td>
            <td class="text-right">{{ row.liters|number_format(2, ',', '.') }}</td>
            <td class="text-right">{{ row.price_per_liter > 0 ? row.price_per_liter|number_format(4, ',', '.') : '—' }}</td>
            <td class="text-right">{{ row.km_at_refuel ? row.km_at_refuel|number_format(0, ',', '.') : '—' }}</td>
            <td class="text-right">{{ row.km_since_last_refuel ? row.km_since_last_refuel|number_format(0, ',', '.') : '—' }}</td>
            <td>{{ row.supplier_name ?: '—' }}</td>
        </tr>
        {% else %}
        <tr><td colspan="10" class="text-center">Nessun elemento</td></tr>
        {% endfor %}
    </tbody>
</table>
{% endblock %}
