{% extends "print/layout.twig" %}

{% block content %}
<table>
    <thead>
        <tr>
            <th>Nome</th>
            <th>Indirizzo</th>
            <th>Comune</th>
            <th>Prov.</th>
            <th>CAP</th>
            <th>Note</th>
        </tr>
    </thead>
    <tbody>
        {% for row in rows %}
        <tr>
            <td>{{ row.name }}</td>
            <td>{{ row.street ?: '—' }}{% if row.suburb %} ({{ row.suburb }}){% endif %}</td>
            <td>{{ row.town ?: '—' }}</td>
            <td class="text-center">{{ row.province ?: '—' }}</td>
            <td class="text-center">{{ row.post_code ?: '—' }}</td>
            <td>{{ row.note ?: '—' }}</td>
        </tr>
        {% else %}
        <tr><td colspan="6" class="text-center">Nessun elemento</td></tr>
        {% endfor %}
    </tbody>
</table>
{% endblock %}
