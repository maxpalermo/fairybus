{% extends "print/layout.twig" %}

{% set status_labels = {'active': 'Attivo', 'maintenance': 'In manutenzione', 'retired': 'Ritirato'} %}

{% block content %}
    <table class="data">
        <thead>
            <tr>
                <th style="width: 6%;" class="center">ID</th>
                <th style="width: 12%;">Targa</th>
                <th style="width: 14%;">Marca</th>
                <th style="width: 18%;">Telaio</th>
                <th style="width: 12%;" class="center">Stato</th>
                <th style="width: 10%;" class="num">KM</th>
                <th>Descrizione</th>
            </tr>
        </thead>
        <tbody>
            {% for row in rows %}
                <tr>
                    <td class="center muted">{{ row.id_vehicle }}</td>
                    <td>{{ row.plate|default('—') }}</td>
                    <td class="muted">{{ row.brand_name|default('—') }}</td>
                    <td class="muted">{{ row.chassis_number|default('—') }}</td>
                    <td class="center">{{ status_labels[row.status]|default(row.status|default('—')) }}</td>
                    <td class="num">{% if row.current_km is not null %}{{ row.current_km|number_format(0, ',', '.') }}{% else %}—{% endif %}</td>
                    <td>{{ row.description|default('—') }}</td>
                </tr>
            {% else %}
                <tr><td colspan="7" class="center muted">Nessun veicolo presente.</td></tr>
            {% endfor %}
        </tbody>
    </table>
{% endblock %}

{% block footer %}
    <span>{{ app_name|default('Fairy Bus') }} — {{ title|default('Documento') }} — Elementi: {{ rows|length }}</span>
{% endblock %}
